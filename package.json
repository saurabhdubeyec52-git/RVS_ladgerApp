{
  "name": "rvs-ledger",
  "version": "1.0.0",
  "description": "RVS Ledger — desktop app to manage customers, credit/debit ledgers, and overdue payment alerts.",
  "main": "out/main/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "build:mac": "bash scripts/build-mac.sh",
    "build:win": "bash scripts/build-win-release.sh",
    "build:all": "bash scripts/build-all.sh",
    "portable:mac": "electron-vite build && electron-builder --mac zip --arm64 && mkdir -p release/runable && mv release/*-portable.zip release/runable/",
    "portable:win": "bash scripts/build-win.sh zip && mkdir -p release/runable && mv release/*-portable.zip release/runable/",
    "portable": "bash scripts/build-portable.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "9.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^22.3.27",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11"
  }
}
